# ---- Storage ----
# SQLite database file for knowledge metadata
CHILDCARE_DB_PATH=./data/childcare.db
# Root directory for immutable raw source artifacts (not committed)
CHILDCARE_RAW_DIR=./data/raw

# ---- Web collection ----
# User-Agent used when fetching public sources
CHILDCARE_USER_AGENT=childcare-agent/0.1 (+https://example.com/bot)
# Per-request timeout in milliseconds
CHILDCARE_FETCH_TIMEOUT_MS=30000
# Max bytes to download per document
CHILDCARE_MAX_DOWNLOAD_BYTES=52428800

# ---- Local question-answer app ----
CHILDCARE_PORT=4174
CHILDCARE_RETRIEVAL_TOP_K=5

# ---- Deployment plan ----
# 回答一律走 DeepSeek。检索用本地小向量模型（和 chatlab 一样，小模型不写答复）。
# qwen3:8b 是对话模型，不参与回答，也不拿来做向量检索。
#   local      本机 5060。DeepSeek 回答 + bge-small 检索。
#   linux-2g   2核2G。同样分工，检索小模型约 95MB。
#   linux-4g   2核4G。同样分工，内存更宽裕。
CHILDCARE_DEPLOY=local

# ---- Model providers ----
# 回答模型。auto / deepseek 都只调用 DeepSeek。只有写成 ollama 才用本机对话模型写答案。
# CHILDCARE_MODEL_PROVIDER: auto | deepseek | ollama
CHILDCARE_MODEL_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 下面三项只有 CHILDCARE_MODEL_PROVIDER=ollama 时才会用来写答案。
# 默认问答不走这里。检索用的是下面的 bge-small，不是 qwen3:8b。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_MODELS=D:\Work\childcare-agent\data\ollama

# ---- Local retrieval model (embeddings) ----
# 本地 ONNX 小模型，约 95 MB，只负责检索，不生成答复。三种部署方案都开启。
# 角色对应 chatlab 的 Qwen3-Embedding-0.6B：小模型做向量，远程模型做回答。
# CHILDCARE_EMBED_SOURCE: huggingface | hf-mirror
# CHILDCARE_EMBED_ENABLED=1
CHILDCARE_EMBED_MODEL=Xenova/bge-small-zh-v1.5
CHILDCARE_EMBED_CACHE_DIR=./data/models
CHILDCARE_EMBED_SOURCE=hf-mirror
