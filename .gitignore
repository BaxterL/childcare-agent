# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment and secrets. Keep the template.
.env
.env.*
!.env.example
apps/web/.certs/
*.pfx
*.pem
passphrase.txt

# Runtime data (raw sources, staging, processed artifacts) must not enter Git
data/raw/
data/collected/
data/staging/
data/processed/
data/releases/
data/models/
data/ollama/
data/*.db
data/*.db-wal
data/*.db-shm
data/chroma/

# Manifests and eval sets are meant to be committed
!data/manifests/
!data/eval/
# Generated evaluation report is rebuilt by `npm run eval`
data/eval/report.json

# Logs
*.log
logs/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local tool config
.commandcode/
# Portable Ollama runtime and its download (stay on D:, not the user profile)
tools/

# Local corpus drop, import logs, and scratch. The knowledge base lives in the ignored database.
incoming/
tmp-*.mjs
tmp-*.py
__pycache__/
*.pyc
